#!/usr/bin/env bash
set -euo pipefail

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    BOLD='\033[1m'
    CYAN='\033[36m'
    GREEN='\033[32m'
    RESET='\033[0m'
else
    BOLD=''
    CYAN=''
    GREEN=''
    RESET=''
fi

echo -e "${BOLD}${CYAN}▶ Pre-push: verifying Rastrio...${RESET}"

./scripts/verify.sh

echo -e "${BOLD}${GREEN}✓ Pre-push checks passed. Proceeding with push.${RESET}"